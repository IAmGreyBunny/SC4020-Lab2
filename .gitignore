# Local Python environment and generated caches.
.venv/
.venv
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local preservation archives and review-only files.
.local_artifacts/

# Deterministic shared data generated by shared_data.py from the six input CSVs.
/data/*_indexed.csv
/data/*_drug_mapping.csv
/data/*_protein_mapping.csv
/data/splits/
/data/preparation_report.json

# Task 1 tables and figures are regenerated by dataset-analysis.ipynb.
/figures/
/outputs/

# Reconstructible full-run states; retain compact scientific evidence instead.
/task2/results/biased_mf/runs/
/task2/results/biased_mf/checkpoints/
/task2/results/biased_mf_reproductions/
/task2/results/task2_submission/

# Open-task data, weights, figures and predictions: all regenerated by the open_task notebooks.
/data/open_task/
/open_task/models/saved_models/
/open_task/figures/
/open_task/predictions/

# Local virtualenv (the existing .venv/ rule misses this directory name).
venv/

# Optional flat split exports; shared tracked partitions live in /data/splits/.
/data/*_train.csv
/data/*_val.csv
/data/*_test.csv
